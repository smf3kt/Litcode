{
  "name": "litcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "bin": { "litcode": "bin/litcode.mjs", "litcode-magpie": "bin/litcode-magpie.mjs", "personal-harness": "bin/personal-harness.mjs" },
  "files": ["bin/", "dist/", "README.md", "NOTICE.md", "THIRD_PARTY_NOTICES.txt"],
  "engines": { "node": ">=22" },
  "scripts": {
    "extract": "node scripts/extract-bun.mjs",
    "identity": "node scripts/identity.mjs",
    "verify:extraction": "node scripts/verify-extraction.mjs",
    "notices": "node scripts/dependency-notices.mjs",
    "notices:check": "node scripts/dependency-notices.mjs --check",
    "source:bundle": "node scripts/source-bundle.mjs",
    "index:modules": "node scripts/index-modules.mjs",
    "agent": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "smoke:media": "node scripts/smoke-media.mjs",
    "smoke:rewind": "node scripts/smoke-rewind.mjs",
    "smoke:memory-reload": "node scripts/smoke-memory-reload.mjs",
    "smoke:mcp-form": "node scripts/smoke-mcp-form.mjs",
    "smoke:plugins": "node scripts/smoke-plugin-components.mjs",
    "smoke:workflow-resume": "node scripts/smoke-workflow-resume.mjs",
    "smoke:workflow-cli": "node scripts/smoke-workflow-cli.mjs",
    "smoke:mcp-subscriptions": "node scripts/smoke-mcp-subscriptions.mjs",
    "smoke:clipboard": "node scripts/smoke-clipboard.mjs",
    "smoke:clipboard-cli": "node scripts/smoke-clipboard-cli.mjs",
    "smoke:tasks": "node scripts/smoke-task-projections.mjs",
    "smoke:worktrees": "node scripts/smoke-worktree-session.mjs",
    "smoke:config-watch": "node scripts/smoke-config-watch.mjs",
    "smoke:config-watch-cli": "node scripts/smoke-config-watch-cli.mjs",
    "smoke:managed-cli": "node scripts/smoke-managed-cli.mjs",
    "smoke:scheduler-cli": "node scripts/smoke-scheduler-cli.mjs",
    "smoke:mcp-logging-cli": "node scripts/smoke-mcp-logging-cli.mjs",
    "smoke:mcp-notification-cli": "node scripts/smoke-mcp-logging-cli.mjs --notification-stream",
    "smoke:coding-task": "node scripts/smoke-coding-task.mjs",
    "smoke:checkpoint-crash": "node scripts/smoke-checkpoint-crash.mjs",
    "smoke:mcp-startup-cli": "node scripts/smoke-mcp-startup-cli.mjs",
    "smoke:mcp-notification": "node scripts/smoke-mcp-notification-stream.mjs",
    "smoke:mcp-reconnect-cli": "node scripts/smoke-mcp-reconnect-cli.mjs",
    "smoke:mcp-recovery-cli": "node scripts/smoke-mcp-recovery-cli.mjs",
    "smoke:mcp-persistence-cli": "node scripts/smoke-mcp-persistence-cli.mjs",
    "smoke:mcp-sampling-images": "node scripts/smoke-mcp-sampling-images.mjs",
    "smoke:mcp-logging": "node scripts/smoke-mcp-logging.mjs",
    "smoke:child-callbacks": "node scripts/smoke-child-callbacks.mjs",
    "smoke:hook-terminal-cli": "node scripts/smoke-hook-terminal-cli.mjs",
    "smoke:stop-cap-cli": "node scripts/smoke-stop-cap-cli.mjs",
    "smoke:skill-agent-cli": "node scripts/smoke-skill-agent-cli.mjs",
    "smoke:skill-inline-cli": "node scripts/smoke-skill-inline-cli.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "tsx --test --test-concurrency=4 --test-timeout=20000 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "parse5": "7.3.0",
    "pdf-lib": "1.17.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/ws": "8.18.2",
    "acorn": "8.15.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
