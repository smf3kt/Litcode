#!/usr/bin/expect -f
set timeout -1
log_user 0
fconfigure stdin -blocking 0 -translation binary -buffering none
fconfigure stdout -translation binary -buffering none
spawn -noecho {*}$argv
proc forward_input {} {
    set bytes [read stdin]
    if {$bytes ne ""} { send -raw -- $bytes }
    if {[eof stdin]} { fileevent stdin readable {} }
}
fileevent stdin readable forward_input
expect {
    -re {.+} { puts -nonewline stdout $expect_out(0,string); exp_continue }
    eof { set result [wait]; exit [lindex $result 3] }
}
