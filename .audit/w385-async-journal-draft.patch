+function cold(root: string, id: string, expected: readonly AsyncHookJournalEvent[]): void {
+  const reader = `import{Session}from'./src/session.ts';import{createHash}from'node:crypto';const s=Session.open(process.argv[1],{id:process.argv[2]});
+    const records=s.events.filter(e=>e.kind==='hook_async'),keys=[...new Set(records.flatMap(Object.keys))].sort();
+    process.stdout.write(JSON.stringify({count:records.length,digest:createHash('sha256').update(JSON.stringify(records,keys)).digest('hex')}));await s.close();`;
+  for (let i = 0; i < 2; i++) {
+    const child = spawnSync(process.execPath, ['--import', 'tsx', '--input-type=module', '-e', reader, root, id],
+      { cwd: process.cwd(), encoding: 'utf8', timeout: 10000 });
+    assert.equal(child.status, 0, child.stderr); assert.deepEqual(JSON.parse(child.stdout), { count: expected.length, digest: factDigest(expected) });
+  }
+}
+
+async function guardedObservation(mode: 'getter' | 'serialization' | 'digest' | 'foreign' | 'replay' | 'returned-event' |
+    'request-drift' | 'unowned-starter' | 'process-failure' | 'callback-failure'): Promise<void> {
+  const root = workspace(), marker = path.join(root, 'command-effect'), script = path.join(root, 'command.mjs');
+  fs.writeFileSync(script, `import fs from 'node:fs';fs.appendFileSync(process.argv[2],'x');process.stdout.write('{}');`);
+  let calls = 0;
+  const provider: ModelProvider = { count: async () => 1, complete: async () => calls++ === 0 ? write(1) : done() };
+  const config = { ...defaultConfig(root, []), model: 'fixture', permissions: { mode: 'bypass' as const, allow: [], deny: [] },
+    features: { tasks: false, subagents: false, background: false },
+    hooks: { PostToolUse: [{ command: `${quote(process.execPath)} ${quote(script)} ${quote(marker)}`, async: true }] } };
+  const runtime = await createRuntime(config, provider, new AbortController().signal); config.tools = pinToolSchemas(runtime.tools);
+  const session = Session.open(root, { config }), other = mode === 'foreign' ? Session.open(root, { config }) : undefined;
+  const append = session.append.bind(session);
+  let touched = 0, getterCalls = 0, settled!: () => void;
+  const boundary = new Promise<void>(resolve => { settled = resolve; });
+  session.append = (event, notification, backup, execution) => {
+    if (event.kind !== 'hook_async') return append(event, notification, backup, execution);
+    if (event.phase === 'registered' && ['getter', 'serialization', 'digest', 'foreign'].includes(mode)) {
+      touched++;
+      const changed = { ...event };
+      if (mode === 'getter') Object.defineProperty(changed, 'jobId', { get() { getterCalls++; return event.jobId; }, enumerable: true });
+      if (mode === 'serialization') Object.defineProperty(changed, 'toJSON', { value: () => { getterCalls++; return event; } });
+      if (mode === 'digest') changed.requestDigest = 'f'.repeat(64);
+      if (mode === 'foreign') { assert.ok(other); assert.throws(() => other.append(event, notification, backup, execution), /authorization invalid/); }
+      else assert.throws(() => append(changed, notification, backup, execution), /authorization invalid/);
+      return append(event, notification, backup, execution);
+    }
+    if (mode === 'process-failure' && event.phase === 'process_completed' || mode === 'callback-failure' && event.phase === 'callback_settled') {
+      touched++; settled(); throw new Error('owned async journal fault');
+    }
+    append(event, notification, backup, execution);
+    if (mode === 'replay') { touched++; assert.throws(() => append(event, notification, backup, execution), /authorization invalid/); }
+    if (mode === 'returned-event') { touched++; event.hookId = randomUUID(); event.jobId = randomUUID(); }
+    if (event.phase === 'callback_settled') settled();
+  };
+  let saved: AsyncHookJournalEvent[] = [];
+  try {
+    assert.ok(runtime.bindSession); await runtime.bindSession(session);
+    const options = runtime.hookOptions?.(session.config, session.id); assert.ok(options?.startAsyncCommand);
+    if (mode === 'unowned-starter') options.startAsyncCommand = async () => 'unowned-job';
+    if (mode === 'request-drift') {
+      const start = options.startAsyncCommand;
+      options.startAsyncCommand = request => start({ ...request, definition: { ...request.definition, command: 'printf changed' } });
+    }
+    await new Agent(session, provider, runtime.buildTools(session.config, session.id), { hookOptions: options }).run('guarded async journal');
+    const active = ['replay', 'returned-event', 'process-failure', 'callback-failure'].includes(mode);
+    if (active) {
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      try { await Promise.race([boundary, new Promise<void>((_resolve, reject) => { timer = setTimeout(() => reject(new Error(`Missing ${mode} boundary`)), 5000); })]); }
+      finally { if (timer) clearTimeout(timer); }
+    }
+    saved = facts(session.events);
+    const expected = mode === 'process-failure' ? 1 : mode === 'callback-failure' ? 2 : active ? 3 : 0;
+    assert.equal(saved.length, expected, mode); assert.equal(getterCalls, 0, mode);
+    assert.equal(fs.existsSync(marker), active, mode);
+    if (active) assert.equal(fs.readFileSync(marker, 'utf8'), 'x');
+    if (mode !== 'request-drift' && mode !== 'unowned-starter') assert.ok(touched > 0, mode);
+    if (other) assert.equal(facts(other.events).length, 0);
+    assert.ok(runtime.drainEvents); const queued = runtime.drainEvents(session.id);
+    assert.equal(queued.length, mode === 'process-failure' || !active ? 0 : 1, mode);
+    assert.ok(runtime.releaseSession);
+    if (mode === 'replay' || mode === 'returned-event' || mode === 'unowned-starter') await runtime.releaseSession(session.id, () => {});
+    else await assert.rejects(runtime.releaseSession(session.id, () => {}), /Runtime cleanup incomplete/, mode);
+  } finally { await runtime.close(); await other?.close(); await session.close(); }
+  cold(root, session.id, saved);
+}
