+import { isDeepStrictEqual, types as utilTypes } from 'node:util';
+import { z } from 'zod';
+
+export const asyncHookProcessStateSchema = z.enum(['completed', 'blocked', 'failed', 'cancelled', 'timed_out']);
+export type AsyncHookProcessState = z.infer<typeof asyncHookProcessStateSchema>;
+const digest = z.string().regex(/^[a-f0-9]{64}$/);
+const observed = z.object({ registryId: z.string().uuid(), jobId: z.string().uuid(), event: z.string().min(1),
+  requestDigest: digest, mode: z.enum(['configured', 'adopted']) });
+const registered = observed.extend({ phase: z.literal('registered'), startedAt: z.number().int().nonnegative() }).strict();
+const completed = observed.extend({ phase: z.literal('process_completed'), state: asyncHookProcessStateSchema,
+  callbackExpected: z.boolean(), completedAt: z.number().int().nonnegative() }).strict();
+const callback = observed.extend({ phase: z.literal('callback_settled'), outcome: z.enum(['none', 'returned', 'threw']) }).strict();
+export const asyncHookObservationSchema = z.discriminatedUnion('phase', [registered, completed, callback]);
+export type AsyncHookObservation = z.infer<typeof asyncHookObservationSchema>;
+
+export const hookCallStartSchema = z.object({ kind: z.literal('hook_start'), id: z.string(), event: z.string(),
+  toolUseId: z.string().optional(), parentMessageId: z.string().uuid().optional() }).strict();
+const journal = { kind: z.literal('hook_async'), owner: z.string().uuid(), hookId: z.string().uuid(),
+  toolUseId: z.string().optional(), parentMessageId: z.string().uuid().optional() };
+export const asyncHookJournalSchema = z.discriminatedUnion('phase', [registered.extend(journal), completed.extend(journal), callback.extend(journal)]);
+export type AsyncHookJournalEvent = z.infer<typeof asyncHookJournalSchema>;
+export const asyncHookJournalEnvelopeSchema = observed.extend(journal).extend({
+  phase: z.enum(['registered', 'process_completed', 'callback_settled']), startedAt: registered.shape.startedAt.optional(),
+  state: completed.shape.state.optional(), callbackExpected: completed.shape.callbackExpected.optional(),
+  completedAt: completed.shape.completedAt.optional(), outcome: callback.shape.outcome.optional(),
+}).strict();
+
+// Host journal boundary for m5e/WLe/CXo, sfn1dbxq [2955889,2958184)/[626248,626520)/[630237,630565), UTF-16.
+export function flatHookJournalRecord(value: unknown): Record<string, unknown> | undefined {
+  if (!value || typeof value !== 'object' || utilTypes.isProxy(value)) return;
+  if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) return;
+  const entries: [string, unknown][] = [];
+  for (const key of Reflect.ownKeys(value)) {
+    if (typeof key !== 'string') return;
+    const field = Object.getOwnPropertyDescriptor(value, key);
+    if (!field || !('value' in field) || field.value !== undefined &&
+        !['string', 'number', 'boolean'].includes(typeof field.value)) return;
+    entries.push([key, field.value]);
+  }
+  return Object.fromEntries(entries);
+}
+
+export function sameHookJournalRecord(value: unknown, expected: unknown): boolean {
+  const record = flatHookJournalRecord(value);
+  return record !== undefined && isDeepStrictEqual(record, expected);
+}
+
+// Source pending records have no durable host pairing; this validator checks the added Session protocol.
+export function validateAsyncHookJournal(events: readonly unknown[], owner: string): void {
+  type Start = z.infer<typeof hookCallStartSchema>;
+  type Registration = Extract<AsyncHookJournalEvent, { phase: 'registered' }>;
+  type Completion = Extract<AsyncHookJournalEvent, { phase: 'process_completed' }>;
+  type State = { phase: 'registered'; start: Registration } |
+    { phase: 'process_completed'; start: Registration; completion: Completion } |
+    { phase: 'callback_settled'; start: Registration };
+  const starts = new Map<string, Start[]>(), jobs = new Map<string, State>(), used = new Set<string>();
+  const invalid: () => never = () => { throw new Error('Async hook journal sequence invalid'); };
+  for (const value of events) {
+    if (!value || typeof value !== 'object' || utilTypes.isProxy(value)) continue;
+    const kind = Object.getOwnPropertyDescriptor(value, 'kind');
+    if (!kind || !('value' in kind)) continue;
+    if (kind.value === 'hook_start') {
+      const start = hookCallStartSchema.parse(flatHookJournalRecord(value));
+      if (used.has(start.id)) invalid();
+      const existing = starts.get(start.id) ?? []; existing.push(start); starts.set(start.id, existing);
+    }
+    if (kind.value !== 'hook_async') continue;
+    const record = asyncHookJournalSchema.parse(flatHookJournalRecord(value));
+    const candidates = starts.get(record.hookId), hook = candidates?.[0];
+    if (record.owner !== owner || candidates?.length !== 1 || !hook || hook.event !== record.event ||
+        hook.toolUseId !== record.toolUseId || hook.parentMessageId !== record.parentMessageId) invalid();
+    const key = JSON.stringify([record.registryId, record.jobId]), current = jobs.get(key);
+    if (record.phase === 'registered') {
+      if (current) invalid();
+      used.add(record.hookId); jobs.set(key, { phase: 'registered', start: record }); continue;
+    }
+    if (!current || current.start.hookId !== record.hookId || current.start.requestDigest !== record.requestDigest ||
+        current.start.mode !== record.mode || current.start.owner !== record.owner || current.start.event !== record.event ||
+        current.start.toolUseId !== record.toolUseId || current.start.parentMessageId !== record.parentMessageId) invalid();
+    if (record.phase === 'process_completed') {
+      if (current.phase !== 'registered') invalid();
+      jobs.set(key, { phase: 'process_completed', start: current.start, completion: record }); continue;
+    }
+    if (current.phase !== 'process_completed' || (record.outcome === 'none') === current.completion.callbackExpected) invalid();
+    jobs.set(key, { phase: 'callback_settled', start: current.start });
+  }
+}
