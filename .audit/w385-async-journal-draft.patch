+      cold(root, child.id, childFacts);
+    }
+    if (mode === 'adopted') {
+      const original = fs.readFileSync(session.file, 'utf8'), rows = original.trimEnd().split('\n').map(line => JSON.parse(line));
+      const positions = rows.flatMap((row, index) => row.kind === 'hook_async' ? [index] : []);
+      for (const corruption of ['owner', 'digest', 'registry', 'parent', 'duplicate', 'missing', 'outcome'] as const) {
