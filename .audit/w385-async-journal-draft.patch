+test('actual root and child hook facts survive queue loss, ownership release and cold reads', { timeout: 60000 }, async () => {
+  for (const mode of ['configured', 'adopted', 'released', 'cancelled', 'child', 'registry-child'] as const) {
+    const root = workspace(), marker = path.join(root, 'hook-effect'), release = path.join(root, 'release'), script = path.join(root, 'hook.mjs');
+    const count = mode === 'configured' ? 60 : 1, controller = new AbortController(), turn = new AbortController();
+    fs.writeFileSync(script, `import fs from 'node:fs';import{setTimeout as delay}from'node:timers/promises';
+      if(${JSON.stringify(mode)}==='adopted'){process.stdout.write('{"async":true}\\n');while(!fs.existsSync(${JSON.stringify(release)}))await delay(5)}
+      if(${JSON.stringify(mode)}==='released')await delay(1000);fs.writeFileSync(${JSON.stringify(marker)},'HOOK_EFFECT');process.stdout.write('{}');`);
+    const command = mode === 'configured' ? `printf '{}'` : `${quote(process.execPath)} ${quote(script)}`;
+    let modelCalls = 0, advance: () => void = () => {};
+    let previous = Promise.resolve();
+    const provider: ModelProvider = { count: async () => 1, complete: async () => {
+      const index = modelCalls++;
+      if (mode === 'configured') {
+        if (index > 0) await previous;
+        previous = new Promise<void>(resolve => { advance = resolve; });
+      }
+      if (mode === 'child' || mode === 'registry-child') {
+        if (index === 0) return response([{ type: 'tool_use', caller: { type: 'direct' }, id: 'child-launch', name: 'agent',
+          input: { prompt: 'child hook write', mode: 'general', ...(mode === 'registry-child' ? { background: false } : {}) } }], 'tool_use');
+        return index === 1 ? write(1) : done();
+      }
+      return index < count ? write(index) : done();
+    } };
+    const config = { ...defaultConfig(root, []), model: 'fixture', maxTurns: count + 4,
+      permissions: { mode: 'bypass' as const, allow: [], deny: [] },
+      features: { tasks: false, subagents: mode === 'child' || mode === 'registry-child', agentMessaging: mode === 'registry-child', background: false },
+      hooks: { PostToolUse: [{ command, timeout: 5, async: mode !== 'adopted' }] } };
+    const runtime = await createRuntime(config, provider, controller.signal); config.tools = pinToolSchemas(runtime.tools);
+    const session = Session.open(root, { config });
+    let releaseResult: Promise<void> | undefined, acknowledgement = false, settledJobs = 0, complete!: () => void;
+    const persisted = new Promise<void>(resolve => { complete = resolve; });
+    const append = session.append.bind(session);
+    session.append = (event, notification, backup, execution) => {
+      append(event, notification, backup, execution);
+      if (event.kind === 'hook_async' && event.phase === 'callback_settled') {
+        advance(); if (++settledJobs >= count) complete();
+      }
+      if (event.kind === 'hook_async' && event.phase === 'registered') {
+        if (mode === 'released' && !releaseResult) { assert.ok(runtime.releaseSession); releaseResult = runtime.releaseSession(session.id, () => { acknowledgement = true; }); }
+        if (mode === 'cancelled') turn.abort();
+      }
+    };
+    let saved: AsyncHookJournalEvent[] = [];
+    try {
+      assert.ok(runtime.bindSession); await runtime.bindSession(session);
+      const options = runtime.hookOptions?.(session.config, session.id); assert.ok(options?.startAsyncCommand);
+      if (mode === 'adopted') {
+        const start = options.startAsyncCommand;
+        options.startAsyncCommand = async request => { const id = await start(request); fs.writeFileSync(release, 'go'); return id; };
+      }
+      const run = new Agent(session, provider, runtime.buildTools(session.config, session.id), { hookOptions: options }).run('owned hook writes', turn.signal);
+      if (mode === 'cancelled') await run.catch(error => { assert.equal(error.name, 'AbortError'); });
+      else await run;
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      try { await Promise.race([persisted, new Promise<void>((_resolve, reject) => { timer = setTimeout(() => reject(new Error(`Missing persisted hook settlement: ${mode}/${settledJobs}`)), 5000); })]); }
+      finally { if (timer) clearTimeout(timer); }
+      if (mode === 'released') { assert.ok(releaseResult); await releaseResult; assert.equal(acknowledgement, true); assert.equal(fs.existsSync(marker), false); }
+      saved = facts(session.events);
+      const registered = saved.filter(record => record.phase === 'registered');
+      assert.equal(registered.length, count);
+      assert.equal(saved.length, count * 3, JSON.stringify({ mode, settledJobs, phases: saved.map(record => record.phase) }));
+      assert.equal(new Set(registered.map(record => record.parentMessageId)).size, count);
+      for (const start of registered) {
+        assert.equal(start.owner, session.id);
+        assert.equal(start.toolUseId, mode === 'child' || mode === 'registry-child' ? 'child-launch' : 'reused-hook-write');
