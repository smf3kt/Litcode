+        assert.equal(new Set(registered.map(record => record.parentMessageId)).size, 60);
+      }
+      if (mode === 'released') assert.equal(saved.find(record => record.phase === 'process_completed')?.state, 'cancelled');
+      const first = saved[0]; assert.ok(first);
