+        if (corruption === 'digest') changed[second!].requestDigest = 'a'.repeat(64);
+        if (corruption === 'registry') changed[second!].registryId = randomUUID();
+        if (corruption === 'parent') changed[second!].parentMessageId = randomUUID();
+        if (corruption === 'duplicate') changed.splice(last!, 0, changed[last!]);
