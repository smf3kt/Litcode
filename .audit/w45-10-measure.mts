import { composerBaseSpans, composerHighlights } from '../src/tui-input-highlights.js';
import { ewe, d3n, vMe, YIt, fB, pue, j5r, Art, mW } from '../src/tui-input-highlights-source.js';
const show = (label: string, value: unknown) => console.log(label, JSON.stringify(value));
show('ewe family', ewe('👩👩👧👦x'));
show('ewe empty', ewe(''));
show('ewe e+accent', ewe('éx'));
show('d3n btw', d3n('/btw why'));
show('d3n shifted', d3n(' /btw why'));
show('d3n upper', d3n('/BTW why'));
show('vMe help', vMe('/help me'));
show('vMe dotted', vMe('/help. done'));
show('mW', [mW(0, 5, [[2, 4]]), mW(0, 5, [[5, 9]]), mW(0, 5, [])]);
show('j5r', j5r('anything'));
show('Art hit', Art('ultracode now'));
show('Art quoted', Art('say "ultracode" now'));
show('YIt', YIt('ultrathink this'));
show('fB', [0, 1, 6, 7, 13].map(n => [fB(n), fB(n, true)]));
show('pue overlap', pue([{ start: 0, end: 4 }], [{ start: 2, end: 3 }, { start: 9, end: 10 }]));
const rain = composerBaseSpans({ value: 'ultrathink', caret: 0, storeValue: 'ultrathink' });
show('base ultrathink', rain);
show('base tail', rain.slice(-1));
show('base ultrathink off', composerBaseSpans({ value: 'ultrathink', caret: 0, storeValue: 'ultrathink', ultrathink: false }));
const known = (name: string) => name === 'help';
show('base command', composerBaseSpans({ value: '/help me', caret: 8, storeValue: '/help me', knownCommand: known }));
show('base unknown command', composerBaseSpans({ value: '/nope me', caret: 8, storeValue: '/nope me', knownCommand: known }));
show('base dotted command', composerBaseSpans({ value: '/help. done', caret: 11, storeValue: '/help. done', knownCommand: known }));
show('base btw notice', composerBaseSpans({ value: '/btw why', caret: 8, storeValue: '/btw why' }));
show('base ghost', composerBaseSpans({ value: 'abc', caret: 0, storeValue: 'abc', ghost: { start: 3, end: 8 } }));
show('base marks free', composerBaseSpans({ value: 'ultrathink', caret: 0, storeValue: 'ultrathink', marks: [{ start: 20, end: 22, color: 'ide' }] }).slice(-1));
show('base marks over', composerBaseSpans({ value: 'ultrathink', caret: 0, storeValue: 'ultrathink', marks: [{ start: 2, end: 4, color: 'ide' }] }).length);
show('base workflow keyword', composerBaseSpans({ value: 'ultracode', caret: 0, storeValue: 'ultracode', workflowKeyword: true }));
show('base ultraplan', composerBaseSpans({ value: 'ultraplan', caret: 0, storeValue: 'ultraplan', ultraplan: [{ start: 0, end: 9 }] }));
show('overlay no runs', composerHighlights({ value: 'ultrathink', caret: 0, storeValue: 'ultrathink' }, []).length);
show('overlay run', composerHighlights({ value: 'ultrathink', caret: 6, storeValue: 'ultrathink' }, [{ start: 2, end: 5, color: 'red' }]));
show('overlay modal', composerHighlights({ value: 'ultrathink', caret: 6, storeValue: 'ultrathink', isModalOverlayActive: true }, [{ start: 2, end: 5, color: 'red' }]));
show('overlay search', composerHighlights({ value: '/btw q', caret: 2, storeValue: '/btw q', isSearchingHistory: true, historyQuery: '/btw', historyMatch: true }, [{ start: 0, end: 2, color: 'red' }]));
