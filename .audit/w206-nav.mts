import { PassThrough, Writable } from 'node:stream';
import { TuiTerminal } from '../src/tui.js';
const input = new PassThrough() as any; input.isTTY = true; input.setRawMode = () => {};
const output = new Writable({ write(_c, _e, d) { d(); } }) as any;
Object.assign(output, { isTTY: true, columns: 40, rows: 10 });
const tui: any = new TuiTerminal({ input, output, history: ['previous task'] }).start();
const key = (t: string) => input.emit('data', t);
await new Promise(r => setTimeout(r, 70));
for (let i = 0; i < 20; i++) tui.append({ kind: 'assistant', text: `line ${i}` });
key('draft'); key('\u000f');
const show = (label: string) => console.log(label, tui.transcriptState.offset, tui.transcriptState.showAll);
show('after ctrl+o');
key('k'); show('k');
key('j'); show('j');
key('\u0005'); show('ctrl+e');
key('g'); show('g');
key('G'); show('G');
key('\x1b[5~'); show('pgup');
key('\x1b[6~'); show('pgdn');
console.log('total', tui.transcriptTotal?.(40));
tui.close();
