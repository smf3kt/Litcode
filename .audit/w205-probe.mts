import fs from 'node:fs'; import os from 'node:os'; import path from 'node:path';
import { PassThrough, Writable } from 'node:stream';
import { setTimeout as delay } from 'node:timers/promises';
import { createRequire } from 'node:module';
const { Terminal } = createRequire(import.meta.url)('@xterm/headless');
import { defaultConfig } from '../src/agent.js';
import { Session } from '../src/session.js';
import { TuiTerminal } from '../src/tui.js';
const root=fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(),'w205-')));
fs.mkdirSync(path.join(root,'user'));
const input=new PassThrough() as any; input.isTTY=true; input.setRawMode=()=>{};
const output=new Writable({write(_c,_e,d){d();}}) as any;
Object.assign(output,{isTTY:true,columns:100,rows:20});
const term=new Terminal({allowProposedApi:true,logLevel:'off'}); term.resize(100,20);
const write=output.write.bind(output);
output.write=(...a:any[])=>{term._core.writeSync(String(a[0]));return write(...a);};
const config=defaultConfig(root,[]); config.model='fixture/footer'; config.configSources={userDir:path.join(root,'user')};
config.permissions={mode:'plan',allow:[],deny:[]} as any;
const session=Session.open(root,{config});
let fired=0; session.subscribePermissions(()=>fired++);
const tui=new TuiTerminal({input,output}); tui.bindStatusLine(session); tui.start();
const lines=()=>{const b=term.buffer.active;return Array.from({length:term.rows},(_,r)=>b.getLine(b.viewportY+r)?.translateToString(true)??'');};
await delay(400);
console.log('IDLE'); for(const l of lines()) if(l.trim()) console.log(JSON.stringify(l));
tui.setRunning(true); await delay(300);
console.log('RUNNING'); for(const l of lines()) if(l.trim()) console.log(JSON.stringify(l));
const out=(session as any).adoptPermissionUpdates([{type:'setMode',mode:'acceptEdits',destination:'session'}]); await delay(300);
console.log('OUTCOME',JSON.stringify({applied:out.applied,dropped:out.dropped,mode:(session as any).permissionUpdates.mode,fired}));
console.log('ACCEPT'); for(const l of lines()) if(l.includes('mode on')||l.includes('accept edits')) console.log(JSON.stringify(l));
tui.close(); session.close(); term.dispose();
