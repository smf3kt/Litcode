import { PassThrough, Writable } from 'node:stream';
import { setTimeout as delay } from 'node:timers/promises';
import { createRequire } from 'node:module';
const { Terminal } = createRequire(import.meta.url)('@xterm/headless');
import { TuiTerminal } from '../src/tui.js';
const input = new PassThrough() as any; input.isTTY = true; input.setRawMode = () => {};
const output = new Writable({ write(_c, _e, d) { d(); } }) as any;
Object.assign(output, { isTTY: true, columns: 100, rows: 24 });
const term = new Terminal({ allowProposedApi: true, logLevel: 'off' }); term.resize(100, 24);
const write = output.write.bind(output);
output.write = (...a: any[]) => { term._core.writeSync(String(a[0])); return write(...a); };
const rows = () => { const b = term.buffer.active; return Array.from({ length: term.rows }, (_, r) => b.getLine(b.viewportY + r)?.translateToString(true) ?? ''); };
const tui = new TuiTerminal({ input, output, progressSettings: { timeFormat: '24-hour', timeZone: 'UTC' } }).start();
const at = Date.UTC(2026, 0, 2, 15, 45, 30);
tui.append({ kind: 'user', text: 'first question', timestamp: at });
tui.append({ kind: 'assistant', text: 'first answer', timestamp: at });
await delay(200);
(tui as any).setShowMessageTimestamps(true);
console.log('stamp fn', typeof (tui as any).timeFormatter.stamp);
console.log('entryStamp', JSON.stringify((tui as any).entryStamp({kind:'user',text:'x',timestamp:at})));
const e0=(tui as any).transcriptState.entries[0];
console.log('rowsFor0', JSON.stringify((tui as any).renderEntryRows(e0, 100).map((r:any)=>r.text)));
console.log('entries', JSON.stringify((tui as any).transcriptState.entries.map((e: any) => [e.kind, e.timestamp])));
console.log('SCREEN'); for (const l of rows()) if (l.trim()) console.log(JSON.stringify(l));
tui.setShowMessageTimestamps(true); await delay(200);
console.log('AFTER SETTING'); for (const l of rows()) if (l.trim()) console.log(JSON.stringify(l));
tui.close(); term.dispose();
